generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// User Model
// ------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  name      String?  // <--- Add this field (use String? for optional or String for required)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgets    Budget[]
  expenses   Expense[]
  categories Category[]

  @@map("users")
}
model Budget {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  year      Int      // e.g. 2026
  month     Int      // 1-12
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforces one monthly budget cap per user
  @@unique([userId, year, month])
  @@map("budgets")
}
model Category {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("terracotta")
  initial   String   @default("G")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // <--- Add @default(now()) here

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([userId, name])
  @@map("categories")
}

model Expense {
  id          String   @id @default(uuid())
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  method      String   @default("Card") // e.g. "Debit ···· 4821"
  year        Int      // Extracted for fast index filtering
  month       Int      // 1-12
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, year, month]) // Index for fast monthly spending queries
  @@map("expenses")
}