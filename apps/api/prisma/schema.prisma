generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// User Model
// ------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgets      Budget[]
  expenses     Expense[]
  categories   Category[]

  @@map("users")
}

// ------------------------------------------------------
// Monthly Budget Model
// ------------------------------------------------------
model Budget {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  year      Int      // e.g. 2026
  month     Int      // 1-12 (Jan - Dec)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents duplicate budgets for the same month per user
  @@unique([userId, year, month])
  @@map("budgets")
}

// ------------------------------------------------------
// Category Model
// ------------------------------------------------------
model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?  // Optional color code (e.g. "#c96f4a")
  initial   String?  // Avatar letter/icon initial (e.g. "G")
  isDefault Boolean  @default(false)

  // Optional link to User (null = global default category for all users)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([userId, name]) // Ensures unique category names per user
  @@map("categories")
}

// ------------------------------------------------------
// Expense Transaction Model
// ------------------------------------------------------
model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  method      String?  // e.g., "Card ···· 4821", "Cash", "Transfer"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date]) // Index for fast retrieval of monthly activity
  @@map("expenses")
}